---
// Galerie der Produktseite (Nachbau von generateGallery aus build.js).
import Picture from './Picture.astro';

interface Props {
  images: string[];
  name: string;
  slug: string;
}

const { images, name, slug } = Astro.props;
---
{images && images.length > 0 && (
<div class="gallery">
  <figure class="gallery__main" id="gallery-main" style={`view-transition-name: vt-${slug}`}>
    <Picture src={`/assets/products/${images[0]}`} alt={name} priority data-gallery-zoom="" aria-label="Bild vergrößern" />
  </figure>
  <div class="gallery__thumbs">
    {images.map((img, i) => (
      <button class="gallery__thumb" data-src={`/assets/products/${img}`} data-index={i} aria-label={`Bild ${i + 1} anzeigen`} aria-current={i === 0 ? 'true' : undefined}><Picture src={`/assets/products/${img}`} alt="" fallbackW={200} fallbackH={200} /></button>
    ))}
  </div>
  <div class="gallery__swipe" aria-hidden="true">
    <div class="gallery__swipe-track">
      {images.map((img, i) => (
        <figure class="gallery__swipe-slide"><Picture src={`/assets/products/${img}`} alt={i === 0 ? name : ''} priority={i === 0} /></figure>
      ))}
    </div>
    {images.length > 1 && (
      <div class="gallery__swipe-dots" role="tablist" aria-label="Bild wählen">
        {images.map((_, i) => (
          <button class={`gallery__swipe-dot${i === 0 ? ' is-active' : ''}`} role="tab" aria-label={`Bild ${i + 1}`} data-dot={i}></button>
        ))}
      </div>
    )}
  </div>
</div>
)}
