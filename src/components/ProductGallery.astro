---
// Galerie der Produktseite (Nachbau von generateGallery aus build.js).
import Picture from './Picture.astro';

interface Props {
  images: string[];
  name: string;
  slug: string;
  imageAlts?: string[];
  kiFlags?: boolean[]; // je Bild: true = mit KI bearbeitet (Etikett), Reihenfolge wie images
}

const { images, name, slug, imageAlts, kiFlags = [] } = Astro.props;
const ki = (i: number) => kiFlags[i] === true;
const irgendKi = kiFlags.some(Boolean);
// Alt-Text je Bild, sonst wie bisher der Produktname am ersten Bild
// fetchpriority=high nur am Hauptbild: Desktop/Tablet zeigt .gallery__main, unter 480 px die Swipe-Galerie.
// Das erste Swipe-Bild lädt eager ohne eigene Priorität; es hat dieselbe Adresse wie das Hauptbild,
// der Browser holt die Datei also nur einmal (kein Doppel-Download, kein zweites high).
const alt = (i: number) => imageAlts?.[i] ?? (i === 0 ? name : '');
---
{images && images.length > 0 && (
<>
<div class="gallery">
  <figure class="gallery__main" id="gallery-main" style={`view-transition-name: vt-${slug}`}>
    <span class="gallery__rahmen"><Picture src={`/assets/products/${images[0]}`} alt={alt(0)} priority data-gallery-zoom="" aria-label="Bild vergrößern" />{irgendKi && <span class="ki-badge" aria-hidden="true" hidden={!ki(0)}>Mit KI verbessert</span>}</span>
  </figure>
  <div class="gallery__thumbs">
    {images.map((img, i) => (
      <button class="gallery__thumb" data-src={`/assets/products/${img}`} data-index={i} data-alt={imageAlts?.[i]} data-ki={ki(i) ? '1' : '0'} aria-label={`Bild ${i + 1} anzeigen`} aria-current={i === 0 ? 'true' : undefined}><Picture src={`/assets/products/${img}`} alt="" fallbackW={200} fallbackH={200} /></button>
    ))}
  </div>
  <div class="gallery__swipe">
    <div class="gallery__swipe-track">
      {images.map((img, i) => (
        <figure class="gallery__swipe-slide"><span class="gallery__rahmen"><Picture src={`/assets/products/${img}`} alt={alt(i)} {...(i === 0 ? { loading: 'eager' } : {})} />{ki(i) && <span class="ki-badge" aria-hidden="true">Mit KI verbessert</span>}</span></figure>
      ))}
    </div>
    {images.length > 1 && (
      <div class="gallery__swipe-dots" role="group" aria-label="Bild wählen">
        {images.map((_, i) => (
          <button class={`gallery__swipe-dot${i === 0 ? ' is-active' : ''}`} aria-label={`Bild ${i + 1} anzeigen`} aria-current={i === 0 ? 'true' : undefined} data-dot={i}></button>
        ))}
      </div>
    )}
  </div>
</div>
{irgendKi && <p class="gallery__ki-note text-sm text-muted">{kiFlags.every(Boolean)
  ? 'Bilder mit KI verbessert, bearbeitet oder erstellt, um verschiedene Einsatzmöglichkeiten zu zeigen.'
  : `Gekennzeichnete Bilder wurden mit KI verbessert, bearbeitet oder erstellt, um verschiedene Einsatzmöglichkeiten zu zeigen.${ki(0) ? '' : ' Das erste Bild ist ein unbearbeitetes Foto.'}`}</p>}
</>
)}
