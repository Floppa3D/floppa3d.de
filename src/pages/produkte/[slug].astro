---
// Produktdetailseite (ersetzt templates/product.html + buildProductPage aus build.js).
import Basis from '../../layouts/Basis.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductColors from '../../components/ProductColors.astro';
import EtsyCta from '../../components/EtsyCta.astro';
import StickyCta from '../../components/StickyCta.astro';
import { SITE_URL, DEFAULT_OG_IMAGE } from '../../data/site';
import { OG_WIDTH, OG_HEIGHT } from '../../data/site';
import { alleProdukte, kiProBild, relatedProducts, productJsonLd, breadcrumbJsonLd, type Product } from '../../lib/produkt';

export async function getStaticPaths() {
  const products = await alleProdukte();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, related: relatedProducts(product, products) },
  }));
}

interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;
const first = product.images && product.images[0];
// Eigene Vorschaukarte je Produkt (tools/make-product-og.mjs), sonst Standardkarte
const ogImage = first ? `${SITE_URL}/assets/og/produkt-${product.slug}.jpg` : DEFAULT_OG_IMAGE;
const absaetze = (product.longDescription || '').split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean);
const poster = first ? `/assets/products/${first}`.replace(/\.png$/i, '.webp') : '';
---
<Basis
  title={product.name}
  description={product.shortDescription}
  path={`produkte/${product.slug}.html`}
  ogType="product"
  ogImage={ogImage}
  ogImageWidth={OG_WIDTH}
  ogImageHeight={OG_HEIGHT}
  ogImageAlt={`${product.name} – ${product.price}`}
  jsonLd={[productJsonLd(product), breadcrumbJsonLd(product)]}
>
<article class="product">
  <div class="container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Brotkrumen">
      <ol class="cluster mono text-xs">
        <li><a href="/">Start</a></li>
        <li><a href="/shop.html">Shop</a></li>
        <li><a href={`/shop.html?kategorie=${product.category}`}>{product.categoryLabel}</a></li>
        <li aria-current="page">{product.name}</li>
      </ol>
    </nav>

    <header class="product__header section--tight">
      <p class="eyebrow">{product.categoryLabel} · {product.material}</p>
      <h1 class="product__title">{product.name}</h1>
    </header>

    <div class="product__layout grid-12">

      <!-- Gallery -->
      <section class="product__gallery-col" aria-label="Produktbilder">
        <ProductGallery images={product.images} imageAlts={product.imageAlts} name={product.name} slug={product.slug} kiFlags={kiProBild(product)} />

        <!-- 3D-/AR-Viewer: bleibt verborgen, solange kein GLB-Modell existiert -->
        <section class="viewer3d" data-model={product.slug} hidden>
          <h2 class="serif">In 3D ansehen</h2>
          <model-viewer src={`/assets/models/${product.slug}.glb`} ios-src={`/assets/models/${product.slug}.usdz`}
            ar="" camera-controls="" touch-action="pan-y"
            poster={poster} style="width:100%; height:420px;"></model-viewer>
          <p class="viewer3d__hint text-sm text-muted">Tipp: Auf dem Smartphone „AR" tippen und das Stück direkt ins eigene Regal stellen.</p>
        </section>
      </section>

      <!-- Info-Spalte: Kurzfassung, Spezifikationen, Farben, Kauf -->
      <aside class="product__info-col">

        <p class="lead product__short">{product.shortDescription}</p>

        <section class="product__meta surface" aria-label="Spezifikationen">
          <h3 class="eyebrow">Spezifikationen</h3>
          {product.details && (
            <dl class="details-list">
              {Object.entries(product.details).map(([key, value]) => <><dt>{key}</dt><dd>{value}</dd></>)}
            </dl>
          )}
        </section>

        <ProductColors colors={product.colors} slug={product.slug} />

        <section class="product__cta" aria-label="Kauf">
          <p class="product__price serif">{product.price}</p>
          <p class="legal-note">Preis inkl. der gesetzlichen Umsatzsteuer, zzgl. Versand.</p>
          <EtsyCta product={product} />
        </section>
      </aside>
    </div>

    <!-- Vertrauens- und Versandhinweise: nachrangig, deshalb unter dem Zweispalter -->
    <div class="product__assurances">
      <ul class="product__trust" aria-label="Vertrauenshinweise">
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          Handgefertigt in Bayern
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          Versand mit DHL
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          Auf Bestellung gedruckt
        </li>
      </ul>
      <p class="product__bundle-hint">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        </svg>
        Mehrere Stücke? Versandkosten fallen nur einmal an.
      </p>
    </div>

    <!-- Langer Produkttext: unter Galerie und Kaufspalte über die volle Breite, ab 1024 px zweispaltig -->
    <section class="product__story">
      <header class="product__story-head">
        <p class="eyebrow">Über das Stück</p>
        <h2 class="serif">Im Detail.</h2>
      </header>
      <div class="product__story-text prose">
        {absaetze.map((absatz) => <p>{absatz}</p>)}
      </div>
    </section>

    <!-- Sicherheits- und Pflegehinweise -->
    <section class="product__safety section--tight" aria-label="Sicherheits- und Pflegehinweise">
      <div class="surface product__safety-box">
        <p class="eyebrow">Sicherheits- und Pflegehinweise</p>
        <ul class="product__safety-list">
          <li>Nicht in unmittelbarer Nähe von offenem Feuer, Heizkörpern oder anderen Hitzequellen platzieren.</li>
          <li>PLA verformt sich bereits ab ca. 55–60 °C, PETG ab ca. 70–80 °C. Direkte, dauerhafte Sonneneinstrahlung im Innenraum (z. B. hinter Fensterglas) kann zu Verformungen führen.</li>
          <li>Nicht spülmaschinenfest. Reinigung mit einem leicht feuchten Tuch ohne aggressive oder scheuernde Reinigungsmittel.</li>
          <li>Kein Spielzeug. Nicht für Kinder unter 36 Monaten geeignet – Kleinteile können sich lösen und verschluckt werden.</li>
          <li>Nicht für den Kontakt mit heißen Speisen oder Getränken sowie nicht für mikrowellengeeignete Anwendungen vorgesehen.</li>
          <li>Bei sichtbaren Beschädigungen, Rissen oder Verformungen Verwendung einstellen.</li>
        </ul>
        <p class="text-sm text-muted">Detaillierte produktspezifische Hinweise finden Sie im jeweiligen Etsy-Listing.</p>
      </div>
    </section>

    <!-- Hersteller & Produktidentifikation (Pflichtangaben nach Art. 19 GPSR) -->
    <section class="product__manufacturer section--tight" aria-label="Hersteller und Produktidentifikation">
      <div class="surface product__manufacturer-box">
        <p class="eyebrow">Hersteller &amp; Produktidentifikation</p>
        <dl class="details-list">
          <dt>Hersteller</dt>
          <dd>Floppa3D GbR</dd>
          <dt>Anschrift</dt>
          <dd>Auweg 45, 85375 Neufahrn bei Freising, Deutschland</dd>
          <dt>Kontakt</dt>
          <dd><a class="tap" href="mailto:management@floppa3d.de">management@floppa3d.de</a></dd>
          <dt>Modellbezeichnung</dt>
          <dd>{product.modelId}</dd>
        </dl>
        <p class="text-sm text-muted">Pflichtangaben gemäß Art. 19 EU-Produktsicherheitsverordnung (VO (EU) 2023/988).</p>
      </div>
    </section>

    <!-- Related -->
    <section class="product__related section">
      <header class="product__related-header">
        <p class="eyebrow">Mehr aus dieser Kategorie</p>
        <h2 class="serif layer-reveal">Verwandte Stücke.</h2>
      </header>
      <div class="bento product__related-grid">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </section>

  </div>

  <StickyCta product={product} />
</article>
</Basis>
