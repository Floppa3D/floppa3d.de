---
// Startseite (ersetzt pages/index.html).
import Basis from '../layouts/Basis.astro';
import ProductCard from '../components/ProductCard.astro';
import { alleProdukte } from '../lib/produkt';
import { SITE_URL } from '../data/site';

const featured = (await alleProdukte()).filter((p) => p.featured);
---
<Basis
  title={'Floppa3D – 3D-Druck: Deko & Auftragsdruck'}
  titleTag={'Floppa3D – 3D-Druck: Deko & Auftragsdruck bei Freising'}
  description={'Floppa3D ist ein kleines 3D-Druck-Studio in Neufahrn bei Freising: Deko aus PLA und PETG und Einzelstücke per Auftragsdruck, auf Bestellung gedruckt.'}
  path=""
  ogImage={`${SITE_URL}/assets/og/home.png`}
>
<!-- HERO -->
<section class="hero hero--featured">
  <div class="container hero__inner">
    <p class="hero__eyebrow eyebrow">Floppa3D · 3D-Druck-Studio in Neufahrn bei Freising</p>
    <h1 class="hero__headline">Vom Filament<br>zur Form.</h1>
    <p class="hero__lead lead">Deko für Tisch, Regal und Fensterbank, dazu Einzelstücke nach Ihren Wünschen – entworfen am Rechner, gedruckt in unserer Werkstatt in Neufahrn bei Freising. Jedes Stück in Kleinstauflage, aus PLA oder PETG.</p>
    <div class="hero__actions cluster">
      <a href="/shop.html" class="btn btn--primary">Shop ansehen</a>
      <a href="/about.html" class="btn btn--ghost">Über uns</a>
    </div>
  </div>
</section>

<!-- FEATURED -->
<section class="featured-strip section">
  <div class="container">
    <header class="featured-strip__heading flex-between">
      <div>
        <p class="eyebrow">Ausgewählt</p>
        <h2 class="serif layer-reveal">Aktuelle Stücke.</h2>
      </div>
      <a class="text-sm tap" href="/shop.html">Alle ansehen →</a>
    </header>
    <div class="featured-strip__grid bento">
      {featured.map((p) => <ProductCard product={p} />)}
    </div>
  </div>
</section>

<!-- CATEGORIES -->
<section class="section">
  <div class="container">
    <header class="category-tiles__heading flow">
      <p class="eyebrow">Sortiment</p>
      <h2 class="serif layer-reveal">Zwei Wege.</h2>
    </header>
    <div class="category-tiles">
      <a class="category-tile reveal category-tile--large category-tile--deko" href="/shop.html?kategorie=deko">
        <div class="category-tile__body">
          <span class="category-tile__label eyebrow">Deko</span>
          <h3 class="category-tile__heading serif">Akzente, präzise.</h3>
          <p class="category-tile__text">Fertige Stücke für Tisch, Regal und Fensterbank – gedruckt, sobald Sie bestellen.</p>
        </div>
      </a>
      <a class="category-tile reveal category-tile--small category-tile--auftragsdruck" href="/auftragsdruck.html">
        <div class="category-tile__body">
          <span class="category-tile__label eyebrow">Auftragsdruck</span>
          <h3 class="category-tile__heading serif">Ihre Idee, gedruckt.</h3>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- ABOUT-SNIPPET -->
<section class="section section--tinted">
  <div class="container container--narrow flow reveal">
    <p class="eyebrow">Über uns</p>
    <h2 class="serif layer-reveal">Made in Germany.</h2>
    <p class="lead">Floppa3D ist ein kleines 3D-Druck-Studio in Neufahrn bei Freising (Bayern), gegründet von Florian Kindler und Paul Breitsprecher – hinter dem genau zwei Leute stehen. Wir drucken nur, was wir uns selbst ins Regal stellen würden, und das meinen wir wörtlich: Jedes Stück geht durch unsere Hände, bevor es in den Karton kommt. Gedruckt wird erst, wenn Sie bestellen – das dauert ein, zwei Tage länger, dafür steht hier nichts im Lager und nichts wird weggeworfen.</p>
    <p><a class="tap" href="/about.html">Unsere Geschichte →</a></p>
  </div>
</section>
</Basis>
