---
// Shop mit Filter (ersetzt pages/shop.html). Das Filter-Skript steckt in main.js,
// die alte Seite bindet kein eigenes ein.
import Basis from '../layouts/Basis.astro';
import ProductCard from '../components/ProductCard.astro';
import { alleProdukte, shopEtsyHref, produktUrl } from '../lib/produkt';
import { SITE_URL } from '../data/site';

const products = await alleProdukte();
const shopHref = shopEtsyHref();
const listeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Alle Stücke im Floppa3D Shop',
  url: `${SITE_URL}/shop.html`,
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: produktUrl(p.slug), name: p.name })),
};
---
<Basis
  title={'Shop'}
  titleTag={'3D-gedruckte Deko kaufen – Shop | Floppa3D'}
  description={'Alle Stücke aus dem Floppa3D Studio. Deko und Einzelstücke per Auftragsdruck, gedruckt in unserer Werkstatt bei Freising aus PLA oder PETG.'}
  path="shop.html"
  jsonLd={[listeJsonLd]}
>
<!-- HERO -->
<section class="hero section--tight">
  <div class="container hero__inner">
    <p class="hero__eyebrow eyebrow">Shop</p>
    <h1 class="hero__headline">Alle Stücke.</h1>
    <p class="hero__lead lead">{products.length} Stücke aus Deko und Auftragsdruck – jedes wird erst gedruckt, wenn Sie es bestellen. {shopHref ? <>Der Verkauf läuft über unseren <a href={shopHref} target="_blank" rel="noopener noreferrer">Etsy-Shop</a>.</> : 'Der Verkauf startet in Kürze über Etsy.'}</p>
  </div>
</section>

<!-- FILTER -->
<section class="shop-filter" aria-label="Produktfilter">
  <div class="container shop-filter__inner cluster">

    <div data-filter-group="kategorie" class="cluster">
      <span class="shop-filter__label eyebrow">Kategorie</span>
      <button type="button" class="shop-filter__chip" data-filter="all">Alle</button>
      <button type="button" class="shop-filter__chip" data-filter="kategorie:deko">Deko</button>
      <button type="button" class="shop-filter__chip" data-filter="kategorie:auftragsdruck">Auftragsdruck</button>
    </div>

    <div data-filter-group="material" class="cluster">
      <span class="shop-filter__label eyebrow">Material</span>
      <button type="button" class="shop-filter__chip" data-filter="material:pla">PLA</button>
      <button type="button" class="shop-filter__chip" data-filter="material:petg">PETG</button>
    </div>

    <p class="shop-filter__count text-sm" data-result-count aria-live="polite"></p>
  </div>
</section>

<!-- PRODUKTE -->
<section class="shop-grid-section section">
  <div class="container">
    <h2 class="visually-hidden">Produkte</h2>
    <div class="shop-grid bento">
      {products.map((p) => <ProductCard product={p} filterAttrs />)}
    </div>

    <div class="empty-state empty-state--centered" data-empty-state hidden>
      <p class="empty-state__heading serif">Kein Stück passt zu Ihrer Auswahl.</p>
      <p class="empty-state__body">Versuchen Sie eine andere Kombination – oder starten Sie mit allen Kategorien.</p>
    </div>
  </div>
</section>
</Basis>
