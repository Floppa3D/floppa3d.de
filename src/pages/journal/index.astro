---
// Journal-Übersicht.
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';

const artikel = (await getCollection('journal')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<Basis
  title={"Journal"}
  titleTag={"Journal: PLA, PETG und Pflege im 3D-Druck | Floppa3D"}
  description={"Notizen aus der Floppa3D-Werkstatt bei Freising: PLA und PETG im Vergleich, Pflegetipps für 3D-gedruckte Deko und was wir beim Drucken lernen."}
  path="journal/index.html"
  ogType="website"
>
<!-- HERO -->
<section class="hero section--tight">
  <div class="container hero__inner">
    <p class="hero__eyebrow eyebrow">Journal</p>
    <h1 class="hero__headline">Notizen aus der Werkstatt.</h1>
    <p class="hero__lead lead">Was wir beim Entwerfen und Drucken lernen – aufgeschrieben für alle, die ihre Stücke besser verstehen (und länger behalten) wollen.</p>
  </div>
</section>

<hr class="section-divider section-divider--full">

<!-- ARTIKEL -->
<section class="section" aria-label="Artikel">
  <div class="container--narrow flow">

    {artikel.map((a) => (
    <article class="surface reveal" style="padding: var(--space-5);">
      <p class="eyebrow">{a.data.eyebrow}</p>
      <h2 class="serif"><a href={`/journal/${a.id}.html`}>{a.data.title}</a></h2>
      <p>{a.data.teaser}</p>
      <p><a class="tap" href={`/journal/${a.id}.html`}>Lesen →</a></p>
    </article>
    ))}

  </div>
</section>
</Basis>
