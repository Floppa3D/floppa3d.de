{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floppa3d-de",
  "compatibility_date": "2026-08-20",
  "build": { "command": "npm run build" },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
